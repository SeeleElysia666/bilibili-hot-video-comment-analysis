model/finetune/base_model/
# LoRA 适配器只有十几 MB，随仓库发布：clone 后下载基座即可直接推理
!model/finetune/lora_adapter/
# TextCNN 权重和 RAG 索引都能用脚本重新生成
model/dl/textcnn.pth
model/rag/
# 训练日志与 checkpoint（运行后生成；output 下 4 个结果 txt 随仓库发布）
output/lora_train/
output/lora_train_log.json
